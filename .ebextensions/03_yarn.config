commands:
  01_install_yarn:
    command: |
      # Install Yarn
      curl -o- -L https://yarnpkg.com/install.sh | bash

      # Create symbolic links for Yarn binaries
      sudo ln -sf $HOME/.yarn/bin/yarn /usr/local/bin/yarn
      sudo ln -sf $HOME/.yarn/bin/yarnpkg /usr/local/bin/yarnpkg

      # Update the PATH environment variable
      echo 'export PATH="$HOME/.yarn/bin:$PATH"' | sudo tee -a /etc/profile

      # Apply the changes to the current shell session
      source /etc/profile